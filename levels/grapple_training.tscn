[sub_resource type="PanoramaSkyMaterial" id="PanoramaSkyMaterial_5ag8f"]
panorama = ExtResource("1_p1343")

[sub_resource type="Sky" id="Sky_284mm"]
sky_material = SubResource("PanoramaSkyMaterial_5ag8f")

[sub_resource type="Environment" id="Environment_lra5m"]
background_mode = 2
background_color = Color(0.6627451, 1, 1, 1)
sky = SubResource("Sky_284mm")
ambient_light_sky_contribution = 0.05

[sub_resource type="Resource" id="Resource_3yf2u"]
script = ExtResource("6_x62k4")
text = "Welcome to the grappling tutorial! Here, your goal is to climb!"
action = 1
jump_to_index = 1
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_3cvtu"]
script = ExtResource("6_x62k4")
text = "To grab a ledge, make sure you're holding down the 'e' key or right bumper on a controller, and then your pseodopods should automatically grab on if you're close enough."
action = 1
jump_to_index = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_p1343"]
script = ExtResource("6_x62k4")
text = "Try not to fall though. You might have to start all over again!"
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_u7ygc"]
script = ExtResource("6_x62k4")
text = "Now we gotta go down the outside, but there are no stairs. We need to shimmy down the ledge holds instead."
action = 1
jump_to_index = 1
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_m7ypi"]
script = ExtResource("6_x62k4")
text = "Go out past me and then try to grab onto the walls from the other side by jumping at them and holding 'e' or right bumper on a controller."
action = 1
jump_to_index = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_ejvdj"]
script = ExtResource("6_x62k4")
text = "Then, slide to the left or right to get down. Be careful when doing this. You wouldn't want to fall!"
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_hos50"]
script = ExtResource("6_x62k4")
text = "You made it!"
action = 1
jump_to_index = 1
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_4frv4"]
script = ExtResource("6_x62k4")
text = "Make sure to hold 'e' or the right bumper for this next jump. It's very hard to make normally."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_x62k4"]
script = ExtResource("6_x62k4")
text = "Now for some ledge climbing! Hold 'e' or the right bumper when jumping to grab on to the slots."
action = 1
jump_to_index = 1
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_l10ay"]
script = ExtResource("6_x62k4")
text = "If you find moving when grabbing hard, you actually have two options: you can either strafe left or right when grabbing, or you can aim left or right instead."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_tfnjb"]
script = ExtResource("6_x62k4")
text = "You clawed your way to victory!"
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

