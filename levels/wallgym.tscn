[sub_resource type="PanoramaSkyMaterial" id="PanoramaSkyMaterial_5ag8f"]
panorama = ExtResource("1_mumyq")

[sub_resource type="Sky" id="Sky_284mm"]
sky_material = SubResource("PanoramaSkyMaterial_5ag8f")

[sub_resource type="Environment" id="Environment_lra5m"]
background_mode = 2
background_color = Color(0.6627451, 1, 1, 1)
sky = SubResource("Sky_284mm")
ambient_light_sky_contribution = 0.05

[sub_resource type="Resource" id="Resource_twa4m"]
script = ExtResource("4_bb7w5")
face_texture = ExtResource("5_bb7w5")
text = "Wellcome to the wall jump gym! Press your arrow keys or joystic against the wall, then jump! See what width you can handle."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_beouf"]
script = ExtResource("4_bb7w5")
text = "This is the tunnel gym. Don't get stuck."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_mumyq"]
script = ExtResource("4_bb7w5")
text = "For one meter wall jumps, you can pretty much just spam jumping while pressed against the wall and eventually get up."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_m02ey"]
script = ExtResource("4_bb7w5")
text = "For 2 meter wall jumps, you can still spam jumping and you'll bounce between walls. Not much skill needed, but it can take a while if you're not lucky. A slightly annoying gap size."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_hd7o8"]
script = ExtResource("4_bb7w5")
text = "Three meter jumps start to feel like actual wall jumps. These are probably the comfiest jumps. Goldilock's wall jumps."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_bb7w5"]
script = ExtResource("4_bb7w5")
text = "Once it gets to four meters, wall jumps start getting pretty hard. I mean, four meters is the size of some decent bedrooms, so few would expect you to make it up four meter gaps."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="Resource" id="Resource_tqqsv"]
script = ExtResource("4_bb7w5")
text = "Five meter gaps are extremely hard. That's why this one was lowered. Bouncing up a five meter gap is pretty special."
action = 2
metadata/_custom_type_script = "uid://gmlq05jfav5a"

[sub_resource type="BoxShape3D" id="BoxShape3D_u7ygc"]
size = Vector3(1000, 1000, 1000)

