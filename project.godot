; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ttrpg3d"
run/main_scene="uid://dn62jfw2feor8"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/save_system.gd"
GlobalsMain="*res://scripts/singleton_global_lib_stuff/globals_main.gd"
AttributionManager="*res://scripts/attribution_manager.gd"
ModManager="*res://scripts/modding/mod_manager.gd"
WorldManager="*res://scripts/world/world_manager.gd"
BattleModeManager="*res://scripts/battle/battle_mode_manager.gd"
TurnTracker="*res://scripts/battle/turn_tracker.gd"
GameSettings="*res://scripts/game_settings.gd"
UiPauseGate="*res://scripts/ui/ui_pause_gate.gd"
InputController="*res://scripts/input/input_controller.gd"
DevConsole="*res://scripts/dev/dev_console.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="SoylentSlime"

[editor_plugins]

enabled=PackedStringArray("res://addons/script_splitter/plugin.cfg")

[global_group]

player=""

