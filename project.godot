; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SoylentSlime"
run/main_scene="uid://dn62jfw2feor8"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/save_system.gd"
GlobalsMain="*res://scripts/singleton_global_lib_stuff/globals_main.gd"
AttributionManager="*res://scripts/attribution_manager.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/script_splitter/plugin.cfg")

[global_group]

player=""

